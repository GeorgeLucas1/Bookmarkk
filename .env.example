crie um arquivo .env com o seguinte conteúdo:
# PostgreSQL credentials, read by docker-compose.yml to create the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bookmark
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL connection string used by the API, built from the values above.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# pgAdmin web UI (http://localhost:${PGADMIN_PORT}), read by docker-compose.yml.
# Inside the Docker network, connect to host "postgres" on port 5432.
PGADMIN_DEFAULT_EMAIL= coloque aqui o seu email
PGADMIN_DEFAULT_PASSWORD= coloque aqui a sua senha
PGADMIN_PORT=5050

# OpenRouter API key. Create one at https://openrouter.ai/keys
# Required for the chat endpoint. Document upload and indexing work without it.
OPENROUTER_API_KEY=

# Chat model served through OpenRouter.
# Any chat-completions model on https://openrouter.ai/models works.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Port for the NestJS API.
PORT=3001

# Origin allowed by the API CORS policy (the Next.js dev server by default).
CORS_ORIGIN=http://localhost:3000

# URL of the API, used by the Next.js server to proxy /api/* requests to it.
# The browser always calls /api on the frontend itself, so no CORS is needed.
API_URL=http://localhost:3001
